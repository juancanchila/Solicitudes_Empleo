# Copia este archivo como ".env" y pon tus datos reales (o llénalo desde el formulario: node scripts/editor.mjs → Claves y Git).
# Aquí van SOLO las claves. Tu información de contacto va en config/yo.json (pestaña Contacto del formulario).
# El agente NUNCA lee ni muestra este archivo.

# --- Cuenta de envío (Gmail personal) ---
# Contraseña de aplicación de Google (16 letras), NO tu contraseña normal: https://myaccount.google.com/apppasswords
GMAIL_USER=tu.correo@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Git personal (mantener este agente actualizado en tu repositorio) ---
# Token fine-grained de GitHub con "Contents: Read and write" SOLO sobre el repositorio del agente.
GIT_USUARIO=tu-usuario-github
GIT_CORREO=tu.correo@gmail.com
GIT_REPO_URL=https://github.com/tu-usuario/agente-correos-personal.git
GIT_RAMA=main
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
